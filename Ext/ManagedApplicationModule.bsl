Список = Новый СписокЗначений;
Список.Добавить(Дата(2003, 09, 20), "Иванов Иван Иванович");
Список.Добавить(Дата(1989, 07, 23), "Магомедов Магомед Магомедович");
Список.Добавить(Дата(2010, 12, 13), "Допотопов Допотоп Допотопович");


СписокЛюдей = Список.ВыбратьЭлемент();
Текдата = ТекущаяДата();
Если СписокЛюдей <> Неопределено Тогда
Годрождения = Год(СписокЛюдей.Значение) ;
Этотгод =  Год(Текдата);   
Возраст = Этотгод - Годрождения;
Сообщение = Новый СообщениеПользователю();  

Если Возраст >= 18 Тогда
	Сообщение.Текст =  СписокЛюдей.Представление + " этот старше 18 лет";
Иначе 
	Сообщение.Текст = СписокЛюдей.Представление + " этот младше 18 лет";
	КонецЕсли;  
Сообщение.Сообщить();
КонецЕсли;
